{
  "$comment": "Values only, read fresh from main on every run. Each key's meaning and story: docs/loop-config.md.",
  "repos": [
    "SahajCloud",
    "SahajAtlasWeb",
    "WeMeditateWeb",
    "SahajAtlasWordpress",
    "claude-workflow"
  ],
  "org": "sydevs",
  "journalRepo": "claude-workflow",
  "ceilings": {
    "$comment": "Caps: fix-ci passes per PR, infra re-runs per head, audit proposals per survey and open.",
    "maxProposalsPerSurvey": 3,
    "maxOpenProposals": 10,
    "ciFixIterations": 3,
    "ciInfraReruns": 2
  },
  "findings": {
    "$comment": "directFixMaxFiles bounds a ticketless direct fix; testGlobs are what test-only.mjs accepts as test-only.",
    "directFixMaxFiles": 2,
    "testGlobs": [
      "**/*.test.*",
      "**/*.spec.*",
      "**/tests/**",
      "**/test/**",
      "**/__tests__/**",
      "**/__mocks__/**",
      "**/test-support/**",
      "vitest.*",
      "playwright.config.*"
    ]
  },
  "labels": {
    "$comment": "journal = the diary, excluded from every worklist; lock = a session holds the item; proposal = bot-filed, no human verb yet.",
    "journal": "ops-journal",
    "lock": "bot:working",
    "proposal": "proposal"
  },
  "assignment": {
    "$comment": "reviewer is requested at mark-ready; respondTo are the logins whose comments count as feedback.",
    "reviewer": "Ardnived",
    "respondTo": [
      "Ardnived",
      "antontcymbal",
      "Copilot"
    ]
  },
  "handlers": {
    "$comment": "handler → skill. model also names the lane routine (ROUTINE_ID_/ROUTINE_TOKEN_<MODEL>) once both are set, else the repo's routine. scope \"repo\" = no item or lock.",
    "implement": {
      "model": "opus",
      "skill": "implement-ticket"
    },
    "implement-roadmap": {
      "model": "opus",
      "skill": "implement-roadmap"
    },
    "revise": {
      "model": "opus",
      "skill": "write-ticket"
    },
    "revise-roadmap": {
      "model": "opus",
      "skill": "revise-roadmap"
    },
    "address-review": {
      "model": "opus",
      "skill": "address-review"
    },
    "fix-ci": {
      "model": "sonnet",
      "skill": "fix-ci"
    },
    "resolve-conflicts": {
      "model": "sonnet",
      "skill": "resolve-conflicts"
    },
    "review-pr": {
      "model": "opus",
      "skill": "review-pr"
    },
    "audit-nightly": {
      "model": "opus",
      "skill": "run-audit",
      "cron": "0 8 * * *",
      "routine": "trig_01WzJ2EnTKEk9BJ2Xf6AQ4x6"
    },
    "audit-deps": {
      "model": "opus",
      "skill": "audit-deps",
      "scope": "repo"
    }
  },
  "dispatch": {
    "$comment": "The Actions dispatcher's values; routines keyed by repo (ROUTINE_ID_<REPO> wins). Each key: docs/loop-config.md#dispatch.",
    "schemaVersion": 1,
    "commandPrefix": "@sydevs-bot",
    "handlers": [
      "implement",
      "implement-roadmap",
      "revise",
      "revise-roadmap",
      "address-review",
      "fix-ci",
      "resolve-conflicts",
      "review-pr",
      "audit-deps"
    ],
    "routines": {
      "SahajCloud": "trig_01CiCX4hDrAiP32S2FAM2phy",
      "SahajAtlasWeb": "trig_01P1f8mXn767iQ6Ve6nZ5jcW",
      "WeMeditateWeb": "trig_01Gdqck1nQggS1Rxmrz9GuW9",
      "SahajAtlasWordpress": "trig_0144RjvvF3qRkqfugMyR6oY2",
      "claude-workflow": "trig_013eDcX1APf1f5NfUzodGE75"
    },
    "enabledHandlers": null,
    "verbs": {
      "issue": [
        "implement",
        "revise",
        "review",
        "block",
        "hold"
      ],
      "pr": [
        "address",
        "review",
        "revise",
        "block",
        "hold",
        "approve"
      ],
      "aliases": {
        "issue": {
          "review": "revise"
        },
        "pr": {
          "revise": "review"
        }
      },
      "unknownIssue": "revise",
      "unknownPr": "address"
    },
    "timeoutsMinutes": {
      "implement": 360,
      "implement-roadmap": 150,
      "revise": 60,
      "revise-roadmap": 120,
      "address-review": 150,
      "fix-ci": 60,
      "resolve-conflicts": 45,
      "review-pr": 45,
      "audit-deps": 90
    },
    "maxAttempts": 3,
    "pendingDueMinutes": 120,
    "reconcileMaxPerEvent": 10,
    "sessionBranchPrefix": "claude/",
    "relayBranchPrefix": "claude/relay-",
    "orphanDraftHours": 6,
    "fireRetry": {
      "inline429MaxSeconds": 60,
      "default429Seconds": 600,
      "max429Seconds": 3600,
      "backoff5xxSeconds": 20
    },
    "githubRetry": {
      "attempts": 3,
      "baseSeconds": 2,
      "rateLimitMaxWaitSeconds": 900
    },
    "rateLimitFloor": 1000,
    "recordHistory": 20,
    "workflow": ".github/workflows/dispatcher.yml",
    "callerWorkflow": ".github/workflows/workflow-state.yml",
    "tokenSecret": "SYDEVS_BOT_PAT",
    "routineTokenSecretPrefix": "ROUTINE_TOKEN_",
    "routineIdVarPrefix": "ROUTINE_ID_"
  },
  "roadmap": {
    "$comment": "The Roadmap tier: issue type, notes and settled markers, spike branch prefix, the env keys a review experiment may call production with.",
    "type": "Roadmap",
    "spikeBranchPrefix": "claude/spike-",
    "notesMarker": "<!-- sydevs-roadmap-notes v2 -->",
    "settledMarker": "<!-- sydevs-settled v1 -->",
    "readOnlyKeys": [
      "SAHAJCLOUD_API_KEY"
    ]
  },
  "ci": {
    "$comment": "noCi = repos green at once; ignoreCheckNames = our own checks, also with a matrix suffix; infraLabel = the annotation title marking infrastructure failure.",
    "infraLabel": "infrastructure-failure",
    "noCi": [],
    "ignoreCheckNames": [
      "dispatch / resolve",
      "dispatch / act",
      "dispatch / journal",
      "dispatch / deps",
      "dispatch / contracts-plan",
      "dispatch / contracts-sync",
      "dispatch / contracts-verify",
      "legacy",
      "state / state"
    ]
  },
  "mergePolicy": {
    "$comment": "loopMayNotMerge = repos never armed; proxyApprove = authors whose own PR the bot approves but never arms.",
    "loopMayNotMerge": [],
    "proxyApprove": [
      "Ardnived"
    ]
  },
  "auditCalendar": {
    "$comment": "UTC weekday → audit skill, or a list taking turns from rotationEpoch; monthly.<weekday>.<n> overrides the nth such weekday.",
    "monday": [
      "audit-deps",
      "audit-contracts"
    ],
    "tuesday": "audit-code",
    "wednesday": "audit-sentry",
    "thursday": "audit-code",
    "friday": "cut-release",
    "saturday": "audit-code",
    "sunday": "improve-loop",
    "rotationEpoch": "2026-10-05"
  },
  "auditAngles": {
    "$comment": "audit-code's rotations, one angle per run of its own day from rotationEpoch; run-audit/calendar.mjs reads them.",
    "tuesday": {
      "family": "risk",
      "angles": [
        "correctness and edge cases",
        "security",
        "error handling and observability",
        "test quality and coverage gaps"
      ]
    },
    "thursday": {
      "family": "experience",
      "angles": [
        "performance",
        "accessibility",
        "i18n completeness",
        "UX consistency",
        "SEO and discoverability"
      ]
    },
    "saturday": {
      "family": "hygiene",
      "angles": [
        "simplicity and abstraction reduction",
        "code comments",
        "dead code and unused dependencies",
        "docs vs reality",
        "build vs buy",
        "best practice research"
      ]
    }
  },
  "deps": {
    "$comment": "The daily Dependabot check (dispatcher/deps.mjs): severities, scopes, windowHours, catchUpDay, and the branch prefix that suppresses a fire.",
    "repos": [
      "SahajCloud",
      "SahajAtlasWeb",
      "WeMeditateWeb"
    ],
    "handler": "audit-deps",
    "severities": [
      "critical",
      "high"
    ],
    "scopes": [
      "runtime"
    ],
    "windowHours": 26,
    "catchUpDay": "monday",
    "branchPrefix": "claude/fix-deps-",
    "routineBranchPrefix": "claude/chore-deps-"
  },
  "sentry": {
    "$comment": "DE region host only; the token lacks org:read. SahajAtlasWordpress ships no Sentry.",
    "apiBase": "https://de.sentry.io/api/0",
    "org": "sy-developers",
    "projects": {
      "SahajCloud": "sahajcloud",
      "SahajAtlasWeb": "sahajatlas-web",
      "WeMeditateWeb": "wemeditate-web"
    },
    "tokenEnvVar": "SENTRY_CLAUDE_WORKFLOW_TOKEN"
  },
  "railway": {
    "$comment": "statusContexts = a preview's commit-status contexts; logLines bounds each log read.",
    "apiBase": "https://backboard.railway.com/graphql/v2",
    "tokenEnvVar": "RAILWAY_TOKEN",
    "statusContexts": [
      "sahajcloud - SahajCloud"
    ],
    "logLines": 500
  },
  "mailpit": {
    "$comment": "Credentials live in the cloud environment as MAILPIT_UI_AUTH, never here.",
    "url": "https://mailpit-production-db88.up.railway.app",
    "retentionDays": 7
  },
  "storybook": {
    "$comment": "The one Storybook version every library pins.",
    "version": "10.6.1"
  },
  "contractSync": {
    "$comment": "Producer files consumers commit copies of; paths and command also drive contract-check in three repos' required CI.",
    "producer": "SahajCloud",
    "branch": "claude/chore-sync-contracts",
    "attestContext": "sydevs / contract-sync",
    "approveWithinMinutes": 30,
    "consumers": {
      "WeMeditateWeb": {
        "sources": [
          "src/payload-types.ts"
        ],
        "command": "pnpm run types:cms",
        "paths": [
          "types/payload/payload-types.ts"
        ]
      },
      "SahajAtlasWeb": {
        "sources": [
          "src/payload-types.ts",
          "src/collections/Events/endpoints/responseTypes.ts",
          "src/lib/atlas/atlas-url-contract.json"
        ],
        "command": "pnpm run types:cms && curl -fsSL --retry 3 -o src/lib/shape/atlas-url-contract.json https://raw.githubusercontent.com/sydevs/SahajCloud/main/src/lib/atlas/atlas-url-contract.json",
        "paths": [
          "src/types/payload/payload-types.ts",
          "src/types/payload/response-types.ts",
          "src/lib/shape/atlas-url-contract.json"
        ]
      },
      "SahajAtlasWordpress": {
        "sources": [
          "src/lib/atlas/atlas-url-contract.json"
        ],
        "command": "curl -fsSL --retry 3 -o tests/atlas-url-contract.json https://raw.githubusercontent.com/sydevs/SahajCloud/main/src/lib/atlas/atlas-url-contract.json",
        "paths": [
          "tests/atlas-url-contract.json"
        ]
      }
    }
  },
  "issueFields": {
    "$comment": "Native org issue fields: readable and writable, not searchable. A PUT replaces every field (format-ticket/SKILL.md).",
    "priority": {
      "fieldId": 14337938,
      "options": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ]
    },
    "holdUntil": {
      "$comment": "Where a hold's date lives. A bare hold picks between defaultDays from now; none past maxHorizonDays.",
      "name": "Hold Until",
      "fieldId": 46423871,
      "maxHorizonDays": 180,
      "defaultDays": [
        30,
        90
      ]
    }
  },
  "relationships": {
    "$comment": "Markers a session writes and the dispatcher converts to native relationships, matched by words, not punctuation.",
    "bodyMarker": "Blocked by",
    "bodyMarkerFormat": "Blocked by: https://github.com/<org>/<repo>/issues/<n> — <one-line reason>"
  },
  "identity": {
    "$comment": "expectedLogin = the sessions' login, checked once per run; dispatcherLogins = every login the loop writes under, REST spelling.",
    "expectedLogin": "sydevs-bot",
    "dispatcherLogins": [
      "sydevs-bot",
      "sydevs-dispatcher[bot]"
    ],
    "commentMarker": "<sub>🤖 Written by the sydevs autonomous loop — see [what this is](https://github.com/sydevs/claude-workflow#the-loop)</sub>"
  },
  "review": {
    "$comment": "skipWhen = no critic and no /simplify at or under both; selfReview = finalize-pr's /code-review levels, normal and tiny.",
    "bodyHeader": "## 🧐 Adversarial review",
    "questionMarker": "<!-- sydevs-question -->",
    "profilePath": "workflow/skills/review-pr/reviewer-profile.md",
    "skipWhen": {
      "maxFiles": 3,
      "maxLines": 100
    },
    "selfReview": {
      "level": "medium",
      "tinyLevel": "high"
    },
    "streamline": {
      "$comment": "The pieces new-pieces.mjs lists for review-pr's streamliner.",
      "newFileLines": 150,
      "grownLines": 80,
      "splitLines": 1500,
      "sourceGlobs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.php",
        "**/*.css",
        "**/*.md",
        "**/*.mdx"
      ],
      "skipGlobs": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/*.d.ts"
      ]
    }
  },
  "journal": {
    "$comment": "One issue per day in journalRepo, created lazily, found by creation date in this timezone.",
    "timezone": "America/Vancouver"
  },
  "projects": {
    "$comment": "The org board; status maps the derivation's keys to the board's option names. Status is derived, never read back.",
    "url": "https://github.com/orgs/sydevs/projects/2",
    "number": 2,
    "status": {
      "awaiting": "Awaiting",
      "blocked": "Blocked",
      "hold": "Hold",
      "pending": "Pending",
      "working": "Working",
      "done": "Done"
    }
  },
  "writing": {
    "$comment": "Character budgets for what the loop writes, <details> included; budget.mjs enforces them. Bodies are unbudgeted but notes.",
    "budgets": {
      "comment": 1200,
      "reviewReply": 600,
      "reviewBody": 2000,
      "journalEntry": 1500,
      "notes": 8000
    },
    "markerRequired": [
      "comment",
      "reviewReply",
      "reviewBody"
    ]
  }
}
